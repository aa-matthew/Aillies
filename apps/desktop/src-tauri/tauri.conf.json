{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aillies",
  "version": "0.9.0-alpha.1",
  "identifier": "is.anyax.aillies",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Aillies",
        "width": 480,
        "height": 640,
        "minWidth": 420,
        "minHeight": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Use a trusted device's Codex account",
    "longDescription": "Aillies routes new Codex chats through a paired device's own login. The login never leaves that device.",
    "copyright": "© 2026 Anyaxis Labs",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": [],
    "macOS": { "minimumSystemVersion": "13.0" },
    "linux": { "deb": { "depends": ["libayatana-appindicator3-1"] } }
  }
}
